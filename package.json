{
  "name": "jaspers-market",
  "version": "1.0.0",
  "description": "Sample Whatsapp App - Jasper's Market",
  "keywords": [
    "whatsapp",
    "webhook"
  ],
  "homepage": "https://github.com/fbsamples/whatsapp-business-jaspers-market#readme",
  "bugs": {
    "url": "https://github.com/fbsamples/whatsapp-business-jaspers-market/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fbsamples/whatsapp-business-jaspers-market.git"
  },
  "license": "BSD",
  "author": "Meta",
  "type": "commonjs",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "facebook-nodejs-business-sdk": "^23.0.1",
    "redis": "^5.8.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "services/booking/**/*.js",
      "!services/booking/public/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
